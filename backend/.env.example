# IntelliFlow backend environment variables
ENVIRONMENT=development
DEBUG=true

# SECURITY
SECRET_KEY=CHANGE_ME_IN_PROD

# DATABASE / REDIS
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/intelliflow
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Seed demo data on startup (Railway: set 1 on first deploy, then 0)
SEED_DEMO_DATA=1

# Railway: Postgres/Redis are auto-injected when you link plugins (DATABASE_URL, REDIS_URL)
# ENVIRONMENT=production
# DEBUG=false
# BACKEND_CORS_ORIGINS=["https://your-app.netlify.app"]

